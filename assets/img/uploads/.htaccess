# Сюда админка кладёт фото. Любые скрипты здесь не запускаются и не отдаются.
<FilesMatch "\.(php\d?|phtml|phar|pl|py|cgi|sh|htm|html|svg|js)$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>
<IfModule mod_mime.c>
  RemoveHandler .php .phtml .php3 .php4 .php5 .php7 .php8 .phar
  RemoveType .php .phtml .php3 .php4 .php5 .php7 .php8 .phar
</IfModule>
